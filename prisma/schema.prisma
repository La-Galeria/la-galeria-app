// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Models

model Insumos {
  id Int @id @default(autoincrement())
  nombre String
  cantidad Int


  gastosInsumos GastoInsumos[]
  compras Compras[]

}

model GastoDeInsumos {
  id Int @id @default(autoincrement())
  fecha DateTime
  insumo Insumo @relation(fields: [idInsumos], references: [id])
  idInsumo Int
  cantidad Int
}

model Compras {
  id Int @id @default(autoincrement())
  fecha DateTime
  insumo Insumo @relation(fields: [idInsumos], references: [id])
  idInsumo Int
  cantidad Int
  valorTotal Int
}

model Productos {
  id Int @id @default(autoincrement())
  nombre String
  cantidad Int
  precio Int
  compras CreacionesDeProductos[]
  ventas Ventas[]
}

model CreacionesDeProductos {
  id Int @id @default(autoincrement())
  fecha DateTime
  producto Producto @relation(fields: [idProductos], references: [id])
  idProductos Int
  cantidad Int
}

model Ventas {
  id Int @id @default(autoincrement())
  fecha DateTime
  producto Producto @relation(fields: [idProductos], references: [id])
  idProductos Int
  cantidad Int
  valorVenta Int
}

model Obligaciones {
  id Int @id @default(autoincrement())
  fecha DateTime
  descripcion String
  valor Int
}


model Usuario {
  id Int @id @default(autoincrement())
  nombreUsuario String
  contrasena String
}