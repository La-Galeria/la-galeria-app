// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Models

model Insumo {
  id Int @id @default(autoincrement())
  nombre String
  cantidad Int


  gastosInsumo GastoDeInsumo[]
  compras Compra[]

}

model GastoDeInsumo {
  id Int @id @default(autoincrement())
  fecha DateTime
  insumo Insumo @relation(fields: [idInsumo], references: [id])
  idInsumo Int
  cantidad Int
}

model Compra {
  id Int @id @default(autoincrement())
  fecha DateTime
  insumo Insumo @relation(fields: [idInsumo], references: [id])
  idInsumo Int
  cantidad Int
  valorTotal Int
}

model Producto {
  id Int @id @default(autoincrement())
  nombre String
  cantidad Int
  precio Int
  creaciones CreacionDeProducto[]
  ventas Venta[]
}

model CreacionDeProducto {
  id Int @id @default(autoincrement())
  fecha DateTime
  producto Producto @relation(fields: [idProducto], references: [id])
  idProducto Int
  cantidad Int
}

model Venta {
  id Int @id @default(autoincrement())
  fecha DateTime
  producto Producto @relation(fields: [idProducto], references: [id])
  idProducto Int
  cantidad Int
  valorVenta Int
}

model Obligacion {
  id Int @id @default(autoincrement())
  fecha DateTime
  descripcion String
  valor Int
}


model Usuario {
  id Int @id @default(autoincrement())
  nombreUsuario String
  nombre String
  contrasena String
}